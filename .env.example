# ---------- Supabase ----------
# Em Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...                # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                    # SERVICE ROLE — segredo, só server

# ---------- Google OAuth (Calendar) ----------
# Em https://console.cloud.google.com → APIs & Services → Credentials
# Crie um OAuth 2.0 Client (Web application) e adicione como redirect URI:
#   http://localhost:3000/api/google/callback   (dev)
#   https://SEU-DOMINIO.netlify.app/api/google/callback   (prod)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
